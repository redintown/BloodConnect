# ── PUBLIC (safe to expose to the browser, prefixed NEXT_PUBLIC_) ──────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Public site origin. Local default is fine for development.
# Production (VERCEL_ENV=production or BLOODCONNECT_ENV=production) REQUIRES
# a non-localhost URL — silent localhost fallback is rejected.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional: set to "production" on non-Vercel production hosts to enforce SITE_URL.
# BLOODCONNECT_ENV=production

# ── SERVER-ONLY (never prefix with NEXT_PUBLIC_, never import in client code) ─
# Service-role key bypasses Row Level Security. Used only in trusted
# server-side contexts (e.g. escalation jobs, admin actions, public search).
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret for /api/cron/escalate (Authorization: Bearer <secret>
# or x-cron-secret). Required for cron; route returns 503 if unset.
# Prefer a long random value. Vercel Cron uses GET with Bearer CRON_SECRET;
# external schedulers should use POST. Unauthenticated requests are rejected.
CRON_SECRET=

# ── NOTIFICATIONS (IN_APP shipped; other channels future) ──────────────────
# Web Push (VAPID keys for the Push API)
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
# SMS provider (e.g. Twilio) — placeholder, provider not yet chosen
SMS_PROVIDER_API_KEY=
SMS_PROVIDER_SENDER_ID=
# Email provider (e.g. Resend/SendGrid) — placeholder
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM_ADDRESS=
# WhatsApp / other messaging provider — placeholder
WHATSAPP_PROVIDER_API_KEY=

# ── FUTURE: MAPS / GEOCODING ───────────────────────────────────────────────
MAPS_PROVIDER_API_KEY=
